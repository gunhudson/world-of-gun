{
  "name": "world-of-gun",
  "version": "0.1.0",
  "private": true,
  "description": "Turn real-life data into an MMORPG-style world: a Cloudflare Worker engine, a three.js client, collectors and a character pipeline.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node test/run.mjs",
    "smoke": "node scripts/smoke.mjs http://localhost:8787",
    "deploy": "bash scripts/deploy.sh",
    "deploy:check": "bash scripts/deploy.sh --check",
    "collectors:dry": "node examples/collectors/run.mjs --dry"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
